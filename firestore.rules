rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userKey) {
      return signedIn() &&
          (request.auth.uid == userKey ||
           request.auth.token.phone_number == userKey);
    }

    function ownsDriverProfile(driverId) {
      return signedIn() && request.auth.uid == driverId;
    }

    function hasSafeDriverFields(driverId) {
      return request.resource.data.uid == driverId
          && request.resource.data.phoneNumber ==
              request.auth.token.phone_number
          && request.resource.data.reviewStatus in [
            'draft',
            'pending'
          ];
    }

    // Passenger accounts and private passenger data.
    match /users/{userKey} {
      allow read, create, update, delete:
          if ownsUserDocument(userKey);

      match /{privateDocument=**} {
        allow read, write:
            if ownsUserDocument(userKey);
      }
    }

    // Driver registration and verification profiles.
    match /drivers/{driverId} {
      allow read, delete:
          if ownsDriverProfile(driverId);

      allow create, update:
          if ownsDriverProfile(driverId) &&
             hasSafeDriverFields(driverId);
    }

    // Passenger single-device session control.
    match /user_sessions/{uid} {
      allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
    }

    // Alpha Plus driver single-device session control. This is kept separate
    // from passenger sessions so the same person can use both apps safely.
    match /driver_sessions/{uid} {
      allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
    }

    // Drivers can submit only their own camera photo for automatic screening
    // and staff review. Review decisions are written by trusted backend/admin
    // code, not by the mobile app.
    match /driver_photo_checks/{driverId} {
      allow read:
          if ownsDriverProfile(driverId);

      allow create:
          if ownsDriverProfile(driverId) &&
             request.resource.data.keys().hasOnly([
               'driverId',
               'storagePath',
               'status',
               'automatedScreeningPassed',
               'submittedAt',
               'updatedAt'
             ]) &&
             request.resource.data.driverId == driverId &&
             request.resource.data.status == 'pending' &&
             request.resource.data.automatedScreeningPassed == true;

      allow update:
          if ownsDriverProfile(driverId) &&
             request.resource.data.driverId == driverId &&
             request.resource.data.status == 'pending' &&
             request.resource.data.automatedScreeningPassed == true &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'storagePath',
               'status',
               'automatedScreeningPassed',
               'submittedAt',
               'updatedAt'
             ]);

      allow delete: if false;
    }

    // Feedback can be submitted but not read from the app.
    match /app_feedback/{feedbackId} {
      allow create:
          if signedIn() &&
             request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if false;
    }

    // Everything else remains private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
